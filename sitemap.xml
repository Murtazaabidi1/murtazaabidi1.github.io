---
layout: null
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- for pg in site.html_pages -%}
{%- unless pg.sitemap == false or pg.url contains '404' %}
  <url><loc>{{ pg.url | replace: 'index.html', '' | absolute_url }}</loc><lastmod>{{ site.time | date_to_xmlschema }}</lastmod></url>
{%- endunless -%}
{%- endfor -%}
{%- for doc in site.publications %}
  <url><loc>{{ doc.url | absolute_url }}</loc></url>
{%- endfor %}
</urlset>
